# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*.local

# Database dumps produced by scripts/backup.ts. Large, binary, and a full copy
# of institutional data — a backup belongs in backup storage, not version
# control, where it cannot be rotated or expired.
backend/backups/

# Uploaded files. These include grievance evidence and vigilance material that
# Phase 0.3 put behind authentication; committing them would republish exactly
# the content that change was made to protect, permanently, in git history.
backend/uploads/
!backend/uploads/.gitkeep

# Working copies taken before a large schema edit. Useful locally, but a second
# schema in the repo is a schema someone will eventually read by mistake.
backend/prisma/*.bak-*
