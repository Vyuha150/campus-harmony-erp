  hostel  Hostel         @relation(fields: [hostelId], references: [id])
}

// Certificates
model CertificateRequest {
  id               String    @id @default(uuid()) @map("_id")
  /// TENANT KEY, added in 0034. All seven registrar tables were GLOBAL.
  /// VerificationRequest is how an employer or another university confirms a
  /// degree is real — decided, before this, by any registrar in the deployment.
  institutionId    String
  studentProfileId String
  type             String // bonafide, transcript, migration
  purpose          String
  copies           Int       @default(1)
  fee              Float     @default(0)
  /// pending (being approved: Finance → HOD → Registrar) | approved (ready to
  /// issue) | issued | collected | rejected | cancelled. Legacy "processing" = pending.
  status           String    @default("pending")
  requestedAt      DateTime  @default(now())
