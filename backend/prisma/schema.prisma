/// Weekly lesson plan for a course.
///
/// Previously this table was created at RUNTIME by `CREATE TABLE IF NOT EXISTS`
/// inside a request handler (backend/src/routes/faculty.ts), so it existed in
/// the database but not in this schema — permanent drift that no migration
/// could reconcile, and DDL issued on a hot path.
///
/// It is now a first-class model with a real foreign key to Course, so deleting
/// a course no longer orphans its lesson plans.
model FacultyLessonPlan {
  id            String   @id @default(uuid()) @map("_id")
  courseId      String
  weekNumber    Int
  topic         String
  subtopics     Json     @default("[]")
  courseOutcome String
  plannedDate   DateTime
  status        String   @default("pending") // pending, in_progress, completed, deferred
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, weekNumber])
  @@index([courseId])
}

// Student Enrollment
model Enrollment {
  id               String  @id @default(uuid()) @map("_id")
  studentProfileId String
  courseId         String
  semester         Int
  /// The working grade shown before a result is published. Historically this
  /// also held NUMERIC internal marks, because the faculty marks screen wrote
  /// `String(total)` into it — a number in a column named `grade`. New writes
  /// put the number in `internalMarks` below; this keeps the letter/working
  /// value it was named for.
  grade            String?

  /// Continuous-assessment marks recorded by the course faculty.
  ///
  /// Separate from `grade` because they are a different kind of value, and
  /// because the examination engine needs them as a NUMBER: `enterExamMarks`
  /// takes `internalMarks` as an input, and before this column existed there
  /// was nowhere for the faculty's figure to travel from — the exam cell had
  /// to re-type marks the faculty had already entered, or leave them null.
  ///
  /// A richer per-component breakdown (quiz / assignment / mid-term) is a
  /// larger design; this is the single total the marks screen actually
  /// collects today.
  internalMarks Float?

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, courseId])
}

