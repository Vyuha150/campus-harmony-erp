// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ═══════════════════════════════════════════════════════════════════════════
// INSTITUTIONAL HIERARCHY  (ADR-0001)
//
// Institution → Campus → School → Department → Programme → Batch → Section
//
// `Institution` is the TENANT ROOT and a hard isolation boundary: no code path
// may return rows from one institution to a principal belonging to another.
// `Campus` is a soft boundary — roles marked INSTITUTION scope (VC, Registrar,
// CoE) see every campus; roles marked CAMPUS scope (Principal, campus admin)
// see only their own.
//
// Before this, the schema had no tenant dimension at all and `User.campus` was
// free text. `Programme` also did not exist, which blocked curriculum, credits,
// electives, multiple entry/exit and every other academic capability.
// ═══════════════════════════════════════════════════════════════════════════

/// A university. The tenant root — every tenant-owned row carries institutionId.
model Institution {
  id        String  @id @default(uuid()) @map("_id")
  /// Short code used in generated identifiers (roll numbers, receipts).
  code      String  @unique
  name      String
  legalName String?
  /// university | deemed_university | autonomous_college | affiliated_college
  type      String  @default("university")

  /// Statutory identifiers used in NAAC / NIRF / AISHE submissions.
  aisheCode String?
  naacGrade String?
  nirfId    String?

  addressLine String?
  city        String?
  state       String?
  pincode     String?
  website     String?
  email       String?
  phone       String?

  /// Institution-level configuration: grading scheme, attendance thresholds,
  /// credit rules. Kept configurable because Indian institutions differ widely
  /// (audit rule 41 — configuration over hard-coding).
  settings Json?

  isActive      Boolean   @default(true)
  establishedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campuses      Campus[]
  schools       School[]
  departments   Department[]
  programmes    Programme[]
  users         User[]
  academicYears AcademicYear[]

  // ── Back-relations added in 0018 ──────────────────────────────────────
  batches                    Batch[]
  sections                   Section[]
  studentProfiles            StudentProfile[]
  facultyProfiles            FacultyProfile[]
  courses                    Course[]
  feeRecords                 FeeRecord[]
  libraryBooks               LibraryBook[]
  libraryLoans               LibraryLoan[]
  libraryPolicies            LibraryPolicy[]
  feeStructures              FeeStructure[]
  payments                   Payment[]
  receipts                   Receipt[]
  idempotencyKeys            IdempotencyKey[]
  notificationTemplates      NotificationTemplate[]
  notificationPolicies       NotificationPolicy[]
  notificationDeliveries     NotificationDelivery[]
  examSessions               ExamSession[]
  examSchedules              ExamSchedule[]
  examRegistrations          ExamRegistration[]
  hallTickets                HallTicket[]
  revaluationRequests        RevaluationRequest[]
  curriculumSchemes          CurriculumScheme[]
  courseBaskets              CourseBasket[]
  schemeCourses              SchemeCourse[]
  coursePrerequisites        CoursePrerequisite[]
  programmeOutcomes          ProgrammeOutcome[]
  courseOutcomes             CourseOutcome[]
  coPoMappings               CoPoMapping[]
  gradeScales                GradeScale[]
  courseResults              CourseResult[]
  semesterResults            SemesterResult[]
  gradeHistories             GradeHistory[]
  fileMetadatas              FileMetadata[]
  admissionCycles            AdmissionCycle[]
  admissionApplications      AdmissionApplication[]
  admissionOffers            AdmissionOffer[]
  governanceCommittees       GovernanceCommittee[]
  committeeMeetings          CommitteeMeeting[]
  institutionalPolicies      InstitutionalPolicy[]
  importJobs                 ImportJob[]
  assessments                Assessment[]
  assessmentCoMarks          AssessmentCoMark[]
  indirectAttainments        IndirectAttainment[]
  obeAttainmentPolicies      ObeAttainmentPolicy[]
  approvalItems              ApprovalItem[]
  workflowDefinitions        WorkflowDefinition[]
  workflowInstances          WorkflowInstance[]
  examProgress               ExamProgress[]
  alumniEvents               AlumniEvent[]
  alumniJobPostings          AlumniJobPosting[]
  mentorshipPrograms         MentorshipProgram[]
  alumniCommunicationRecords AlumniCommunicationRecord[]
  progressionSurveys         ProgressionSurvey[]
  institutionKPIs            InstitutionKPI[]
  complianceReports          ComplianceReport[]
  policyScenarios            PolicyScenario[]
  companies                  Company[]
  facilities                 Facility[]
  teams                      Team[]
  hostels                    Hostel[]
  interDeptEvents            InterDeptEvent[]
  degreeRecords              DegreeRecord[]
  trainingSessions           TrainingSession[]
  placementMessages          PlacementMessage[]
  sportsEvents               SportsEvent[]
  aqarRecords                AQARRecord[]
  iqacActionItems            IQACActionItem[]
  qualityDocuments           QualityDocument[]
  iqacMeetings               IQACMeeting[]
  systemNotificationRecords  SystemNotificationRecord[]
  journalEntries             JournalEntry[]
  antiRaggingAffidavits      AntiRaggingAffidavit[]
  qualityMetrics             QualityMetric[]
  transferRequests           TransferRequest[]
  vacancies                  Vacancy[]
  accreditationChecklists    AccreditationChecklist[]
  incidentReports            IncidentReport[]
  sportsAthletes             SportsAthlete[]
  sportsTeams                SportsTeam[]
  sportsAttendance           SportsAttendance[]
  sportsFacilities           SportsFacility[]
  sportsInventoryItems       SportsInventoryItem[]
  meetings                   Meeting[]
  broadcastMessages          BroadcastMessage[]
  grievanceCases             GrievanceCase[]
  complianceItems            ComplianceItem[]
  vendors                    Vendor[]
  purchaseOrders             PurchaseOrder[]
