}

// Security — Support Tickets
model SupportTicket {
  id                 String    @id @default(uuid())
  ticketNumber       String    @unique
  reportedBy         String
  reporterType       String
  contactInfo        String
  category           String
  priority           String    @default("medium")
  subject            String
  description        String
  attachments        Json?
  assignedTo         String?
  status             String    @default("open")
  createdDate        DateTime  @default(now())
  lastUpdate         DateTime  @default(now())
  resolutionDate     DateTime?
  resolutionNotes    String?
  satisfactionRating Int?
}

// Admin — Audit Logs (system-wide)
model SystemAuditLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  role      String
  action    String
  module    String
  resource  String
  details   String
  ipAddress String   @default("0.0.0.0")
  userAgent String?
  timestamp DateTime @default(now())
  severity  String   @default("info")
}

// Admin — System Notifications
model SystemNotificationRecord {
  id                String    @id @default(uuid())
  title             String
  message           String
  type              String    @default("info")
  targetRoles       Json?
  targetDepartments Json?
  sentBy            String
  sentDate          DateTime  @default(now())
  readCount         Int       @default(0)
  totalRecipients   Int       @default(0)
  status            String    @default("draft")
  scheduledDate     DateTime?
}

// Admin — Module Configuration
model ModuleConfig {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String   @default("Box")
  enabled     Boolean  @default(true)
  roles       Json?
  subModules  Json?
  lastUpdated DateTime @default(now())
}

// Admin — Academic Year
model AcademicYear {
  id        String   @id @default(uuid())
  year      String   @unique
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  semesters Json?
  status    String   @default("upcoming")
}

// Admin — Backup Records
model BackupRecord {
  id          String   @id @default(uuid())
  type        String
  size        String
  createdDate DateTime @default(now())
  status      String   @default("in_progress")
  duration    String?
  initiatedBy String
  location    String
}
