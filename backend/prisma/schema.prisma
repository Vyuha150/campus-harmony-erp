// ═══════════════════════════════════════════════════════════════════════════
// FINANCE — PAYMENTS, RECEIPTS, IDEMPOTENCY
//
// The audit's finding: 4 uses of `$transaction` across 478 endpoints, and fee
// payment + receipt creation was explicitly named as an operation that MUST be
// atomic and was not. A mid-operation failure could record money as received
// with no receipt, or a receipt with no payment — either way an institution's
// financial records need reconciling by hand.
//
// There was also no idempotency anywhere: a double-clicked submit or a repeated
// payment-gateway callback would create duplicate payments.
//
// `Payment` and `Receipt` below are written in ONE transaction, guarded by an
// idempotency key.
// ═══════════════════════════════════════════════════════════════════════════

/// A payment against one or more fee records.
model Payment {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  studentProfileId String

  /// Human-facing reference, e.g. PAY-2026-000123.
  paymentNumber String

  amount Float
  /// cash | cheque | dd | online | upi | card | netbanking | adjustment
  method String

  /// Gateway/bank reference where one exists.
  transactionReference String?
  /// Gateway name, for reconciliation.
  gateway              String?

  /// pending | success | failed | refunded | cancelled
  status String @default("pending")

  paidAt       DateTime  @default(now())
  reconciledAt DateTime?

  /// Who recorded it — an offline payment is entered by a cashier.
  recordedBy String

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]
  receipt     Receipt?

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([institutionId, paymentNumber])
  @@index([institutionId])
  @@index([studentProfileId])
  @@index([status])
  @@index([transactionReference])
}

/// How a payment is split across fee records.
///
/// A single payment commonly clears several dues (tuition + library + exam), so
/// the allocation is explicit rather than implied by amount matching.
model PaymentAllocation {
  id        String @id @default(uuid()) @map("_id")
  paymentId String

  feeRecordId String
  amount      Float

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  feeRecord FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Restrict)

  @@unique([paymentId, feeRecordId])
  @@index([feeRecordId])
}

/// A receipt. Created in the SAME TRANSACTION as its payment.
model Receipt {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  paymentId String @unique

  receiptNumber String
  /// Financial year the number belongs to — receipt series usually reset.
  financialYear String

  amount        Float
  amountInWords String?

  studentName String
  rollNumber  String

  issuedAt DateTime @default(now())
  issuedBy String

  /// Printed on the receipt so a holder can verify it independently.
  verificationCode String

  /// issued | cancelled | reprinted
  status             String    @default("issued")
  cancelledAt        DateTime?
  cancelledBy        String?
  cancellationReason String?

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, receiptNumber, financialYear])
  @@index([institutionId])
  @@index([verificationCode])
}

/// Idempotency records for operations that must not run twice.
///
/// A double-clicked submit, a retried request, or a payment gateway that
/// delivers the same webhook twice must all produce ONE payment. The stored
/// response is replayed so the caller sees the original outcome rather than a
/// confusing conflict.
model IdempotencyKey {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  /// Client-supplied key, unique per institution.
  key String

  /// Operation this key guards, e.g. `payment.record`.
  operation String

  /// Hash of the request body, so the SAME key with DIFFERENT data is caught —
  /// that is a client bug, not a retry, and must not silently return the old
  /// response.
  requestHash String

  /// in_progress | completed | failed
  status String @default("in_progress")

  /// Stored response, replayed on a repeat.
  responseBody   Json?
  responseStatus Int?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  /// Keys expire so the table does not grow without bound.
  expiresAt   DateTime 

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, key])
  @@index([institutionId])
  @@index([expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATION & COMMUNICATION ENGINE
//
// The audit's finding: `Notification` and `SystemNotificationRecord` stored
// messages with `readCount` and `totalRecipients`, and the Admin UI displayed
// them — but NOTHING SENT ANYTHING. No email, no SMS, no push. The system
// reported delivery statistics for messages it had never delivered.
//
// Blueprint architecture:
//   event → notification policy → recipients → channel → template → queue
//         → provider → delivery status
//
// The models below implement that chain. `NotificationDelivery` is the piece
// that was missing: one row per recipient per channel, carrying the real
// outcome, so "sent" means sent rather than "stored".
// ═══════════════════════════════════════════════════════════════════════════

/// A reusable, versioned message template.
model NotificationTemplate {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  code String
  name String

  /// The domain event this template renders, e.g. `fee.overdue`,
  /// `result.published`, `attendance.shortage`, `admission.offered`.
  eventType String

  /// in_app | email | sms | push | whatsapp
  channel String

  /// Subject line — email/push only.
  subject String?
  /// Body with `{{placeholder}}` tokens substituted at render time.
  body    String

  /// Placeholders this template expects, so a policy can be validated against
  /// it before anyone relies on it in production.
  requiredVariables Json?

  /// Versioned: a message sent in 2026 should remain reproducible even after
  /// the template is rewritten (audit rule 64).
  version  String  @default("1.0")
  isActive Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries NotificationDelivery[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code, version])
  @@index([institutionId])
  @@index([eventType, channel])
}

/// Who is notified about what, and how.
///
/// Keeping this as DATA is the point: which roles hear about a fee default, and
/// on which channels, is an institutional policy decision — not something that
/// should require a code change.
model NotificationPolicy {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  code      String
  name      String
  eventType String

  /// Channels to attempt, in order.
  channels Json

  /// Who receives it: role names, plus flags for the subject of the event and
  /// their guardian (Indian institutions routinely notify parents).
  targetRoles    Json?
  notifySubject  Boolean @default(true)
  notifyGuardian Boolean @default(false)

  /// Delay before sending, for digests or grace periods.
  delayMinutes Int @default(0)

  isActive Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([eventType])
}

/// One delivery attempt to one recipient on one channel.
///
/// THE MODEL THAT WAS MISSING. Without it there was no way to know whether a
/// message reached anyone — which is why the previous "readCount" figures were
/// meaningless.
model NotificationDelivery {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  eventType  String
  templateId String?
  policyCode String?

  /// Recipient. `userId` is null for external recipients (guardians, alumni).
  userId           String?
  recipientName    String?
  /// Email address or phone number actually used.
  recipientAddress String

  channel String
  subject String?
  body    String

  /// pending | sending | sent | delivered | failed | bounced | skipped
  status String @default("pending")

  /// Which provider handled it, and its message id where one is returned.
  provider          String?
  providerMessageId String?

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  /// In-app read tracking — meaningful now that delivery is real.
  readAt DateTime?

  /// The entity that triggered this, e.g. ('FeeRecord', '<uuid>').
  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([status])
  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// EXAMINATION LIFECYCLE
//
// Blueprint: "The ERP ensures only eligible students (attendance and fee
// compliance) can register, enforcing academic rules."
//
// The audit found 8 endpoints for what is one of the most complex domains in
// any HEI ERP, and no lifecycle at all: no exam registration, no eligibility
// enforcement, no hall tickets, no moderation, no revaluation.
//
// The `Examination` model that already existed is a bare timetable row; it is
// left untouched and superseded by `ExamSchedule` below, which hangs off a
// session and carries the workflow.
// ═══════════════════════════════════════════════════════════════════════════

/// An examination event — e.g. "End Semester Examinations, Nov 2026".
model ExamSession {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String?

  code String
  name String
  /// internal | mid_semester | end_semester | supplementary | revaluation | special
  type String

  academicYear String
  semester     Int

  registrationStartsAt DateTime
  registrationEndsAt   DateTime
  examStartsAt         DateTime
  examEndsAt           DateTime

  /// ── Eligibility rules, per session ────────────────────────────────────────
  /// Institutions differ and rules change year to year, so these are DATA.
  /// UGC/AICTE commonly mandate 75%; some institutions set higher.
  minAttendancePercentage Float   @default(75)
  /// Whether outstanding fees block registration.
  requireFeeClearance     Boolean @default(true)
  /// Late registration fee, if the institution permits late entry.
  lateRegistrationFee     Float?

  /// draft | registration_open | registration_closed | in_progress
  /// | evaluation | moderation | results_published | archived
  status String @default("draft")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules     ExamSchedule[]
  registrations ExamRegistration[]
  /// Oversight rows reporting on this session — see `ExamProgress`.
  progressViews ExamProgress[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  // ── Back-relations added in 0019 ──
  hallTickets HallTicket[]

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([status])
  @@index([academicYear, semester])
}

/// A scheduled paper: one course, one date, one venue.
model ExamSchedule {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  sessionId     String
  courseId      String

  examDate     DateTime
  startTime    String
  endTime      String
  venue        String?
  maxMarks     Int      @default(100)
  /// Marks required to pass this paper, where it differs from the grade scale.
  passingMarks Int?

  /// Faculty responsible for setting and evaluating.
  paperSetterId String?
  evaluatorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  course  Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)

  registrations ExamRegistration[]
  hallTickets   HallTicketEntry[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  paperSetter User? @relation(name: "ExamSchedule_paperSetter", fields: [paperSetterId], references: [id], onDelete: SetNull)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  evaluator User? @relation(name: "ExamSchedule_evaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@unique([sessionId, courseId])
  @@index([institutionId])
  @@index([sessionId])
  @@index([examDate])
}

/// A student's registration for one paper.
///
/// Records the ELIGIBILITY DECISION and the figures behind it, so a refusal is
/// explainable months later — "you were at 68% against a 75% requirement" —
/// rather than an unexplained rejection.
model ExamRegistration {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  sessionId        String
  scheduleId       String
  studentProfileId String

  /// Eligibility snapshot AT THE TIME OF REGISTRATION. Attendance keeps
  /// changing; the decision must remain reconstructable.
  attendancePercentage Float?
  attendanceMet        Boolean @default(false)
  feesCleared          Boolean @default(false)
  outstandingFeeAmount Float?

  isEligible           Boolean @default(false)
  ineligibilityReasons Json?

  /// Condonation — an authority may waive a shortfall. Recorded with who and
  /// why, because a waiver is precisely the kind of decision that must be
  /// auditable.
  isCondoned        Boolean   @default(false)
  condonedBy        String?
  condonedAt        DateTime?
  condonationReason String?
  /// The student's own request for condonation (Examinations → Condonation),
  /// decided through ATTENDANCE_CONDONATION: course teacher → HOD → Dean → CoE.
  condonationRequest     String?
  condonationRequestedAt DateTime?
  condonationDocumentUrl String?

  /// registered | ineligible | condoned | cancelled | absent | appeared
  status String @default("registered")

  registeredAt DateTime @default(now())
  registeredBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, studentProfileId])
  @@index([institutionId])
  @@index([sessionId])
  @@index([studentProfileId])
  @@index([status])
}

/// A hall ticket — issued only once every registration is eligible.
model HallTicket {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  sessionId        String
  studentProfileId String

  ticketNumber     String
  /// Verification code printed on the ticket, checkable at the hall.
  verificationCode String

  issuedAt      DateTime  @default(now())
  issuedBy      String
  /// valid | revoked
  status        String    @default("valid")
  revokedAt     DateTime?
  revokedReason String?

  entries HallTicketEntry[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([institutionId, ticketNumber])
  @@unique([sessionId, studentProfileId])
  @@index([institutionId])
  @@index([verificationCode])
}

/// One paper line on a hall ticket.
model HallTicketEntry {
  id           String @id @default(uuid()) @map("_id")
  hallTicketId String
  scheduleId   String

  seatNumber String?
  roomNumber String?

  hallTicket HallTicket   @relation(fields: [hallTicketId], references: [id], onDelete: Cascade)
  schedule   ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([hallTicketId, scheduleId])
  @@index([scheduleId])
}

/// A revaluation or re-check request.
model RevaluationRequest {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  courseResultId   String
  studentProfileId String

  /// recheck | revaluation | answer_script_copy
  type String @default("revaluation")

  requestNumber String
  reason        String?
  fee           Float   @default(0)
  feePaid       Boolean @default(false)

  originalMarks Float
  revisedMarks  Float?
  /// Whether the outcome changed the grade — reported in exam analytics.
  marksChanged  Boolean @default(false)

  /// requested | fee_pending | under_evaluation | completed | rejected
  status String @default("requested")

  requestedAt DateTime  @default(now())
  evaluatedBy String?
  evaluatedAt DateTime?
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([institutionId, requestNumber])
  @@index([institutionId])
  @@index([courseResultId])
  @@index([studentProfileId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// CURRICULUM & OUTCOME-BASED EDUCATION
//
// `Programme` existed but had no structure beneath it. Without curriculum,
// none of the following was representable: which courses a degree requires,
// electives, prerequisites, credit distribution, honours variants, or the
// CO/PO mapping that NBA accreditation and NAAC Criterion 1 depend on.
//
// VERSIONED (audit rule 64): a student admitted under regulation R2024 must
// graduate under R2024 even after the university publishes R2027. Curriculum
// changes therefore create a NEW scheme rather than mutating the old one.
// ═══════════════════════════════════════════════════════════════════════════

/// A versioned curriculum ("regulation") for one programme.
model CurriculumScheme {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  programmeId   String

  /// Regulation code as the institution publishes it, e.g. "R2026".
  code String
  name String

  /// Cohorts this scheme governs. A student is bound to the scheme in force
  /// at admission, which is why these are recorded rather than assumed.
  effectiveFromYear Int
  effectiveToYear   Int?

  /// Total credits required to graduate under this scheme.
  totalCreditsRequired Int

  /// Minimum and maximum credits a student may register per semester.
  /// Enforced at registration — an overload needs explicit approval.
  minCreditsPerSemester Int @default(12)
  maxCreditsPerSemester Int @default(30)

  /// draft | approved | active | superseded
  status String @default("draft")

  /// Board of Studies / Academic Council approval — NAAC Criterion 1 evidence.
  approvedBy    String?
  approvedAt    DateTime?
  approvingBody String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  baskets       CourseBasket[]
  schemeCourses SchemeCourse[]
  outcomes      ProgrammeOutcome[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code, programmeId])
  @@index([institutionId])
  @@index([programmeId])
  @@index([status])
}

/// A group of courses with a shared credit requirement.
///
/// This is what makes electives expressible: "choose 12 credits from the
/// Professional Elective basket" is a rule, not a hard-coded course list.
model CourseBasket {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  schemeId      String

  code String
  name String
  /// core | professional_elective | open_elective | mandatory |
  /// ability_enhancement | project | internship
  type String

  /// Credits a student must earn from this basket to graduate.
  creditsRequired Int
  /// Minimum/maximum courses selectable. Null means unconstrained.
  minCourses      Int?
  maxCourses      Int?

  /// Core baskets are compulsory in full; elective baskets are a choice.
  isElective Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheme        CurriculumScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  schemeCourses SchemeCourse[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([schemeId, code])
  @@index([institutionId])
  @@index([schemeId])
}

/// A course placed within a scheme, at a semester, in a basket.
///
/// Separate from `Course` because the same course can appear in several
/// schemes at different semesters with different credit weightings — the
/// placement is scheme-specific, the course is not.
model SchemeCourse {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  schemeId      String
  basketId      String
  courseId      String

  /// Semester in which this course is offered under this scheme.
  semester Int

  /// Credits under THIS scheme, which may differ from `Course.credits`.
  credits Int

  /// Contact hours, used for workload and NAAC teaching-learning evidence.
  lectureHours   Int @default(0)
  tutorialHours  Int @default(0)
  practicalHours Int @default(0)

  isMandatory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheme CurriculumScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  basket CourseBasket     @relation(fields: [basketId], references: [id], onDelete: Cascade)
  course Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  prerequisites CoursePrerequisite[] @relation("DependentCourse")
  requiredFor   CoursePrerequisite[] @relation("PrerequisiteCourse")
  outcomes      CourseOutcome[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  // ── Back-relations added in 0019 ──
  assessments Assessment[]

  @@unique([schemeId, courseId])
  @@index([institutionId])
  @@index([schemeId, semester])
  @@index([basketId])
}

/// A prerequisite relationship between two courses in a scheme.
model CoursePrerequisite {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  /// The course that HAS the prerequisite.
  schemeCourseId             String
  /// The course that must be completed first.
  prerequisiteSchemeCourseId String

  /// mandatory  — must be PASSED before registering
  /// corequisite — must be taken in the same semester
  /// advisory   — recommended, warns but does not block
  type String @default("mandatory")

  /// Minimum grade point required in the prerequisite, if any.
  minGradePoint Float?

  createdAt DateTime @default(now())

  schemeCourse       SchemeCourse @relation("DependentCourse", fields: [schemeCourseId], references: [id], onDelete: Cascade)
  prerequisiteCourse SchemeCourse @relation("PrerequisiteCourse", fields: [prerequisiteSchemeCourseId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([schemeCourseId, prerequisiteSchemeCourseId])
  @@index([institutionId])
  @@index([schemeCourseId])
}

/// Programme Outcome (PO) or Programme Specific Outcome (PSO).
///
/// Required for NBA accreditation and NAAC Criterion 1. The old code's only
/// reference to outcomes was FABRICATED — `faculty.ts` wrote `CO${week}` into
/// auto-generated lesson plans.
model ProgrammeOutcome {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  schemeId      String

  /// PO | PSO
  type      String  @default("PO")
  /// e.g. "PO1", "PSO2"
  code      String
  statement String
  /// Graduate attribute this maps to, where the institution tracks them.
  attribute String?

  /// Threshold (%) at which this outcome counts as attained.
  attainmentThreshold Float @default(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheme   CurriculumScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  mappings CoPoMapping[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([schemeId, code])
  @@index([institutionId])
  @@index([schemeId])
}

/// Course Outcome (CO) — what a student should be able to do after a course.
model CourseOutcome {
  id             String @id @default(uuid()) @map("_id")
  institutionId  String
  schemeCourseId String

  /// e.g. "CO1"
  code      String
  statement String

  /// Bloom's taxonomy level, where the institution records it.
  bloomLevel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schemeCourse        SchemeCourse         @relation(fields: [schemeCourseId], references: [id], onDelete: Cascade)
  mappings            CoPoMapping[]
  indirectAttainments IndirectAttainment[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution        Institution         @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  assessmentOutcomes AssessmentOutcome[]
  assessmentCoMarks  AssessmentCoMark[]

  @@unique([schemeCourseId, code])
  @@index([institutionId])
  @@index([schemeCourseId])
}

/// CO → PO mapping with correlation strength.
///
/// The matrix NBA asks for. Strength is conventionally 1 (slight), 2 (moderate)
/// or 3 (substantial); attainment rolls up from CO attainment weighted by these.
model CoPoMapping {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  courseOutcomeId    String
  programmeOutcomeId String

  /// 1 = slight, 2 = moderate, 3 = substantial.
  strength Int @default(1)

  createdAt DateTime @default(now())

  courseOutcome    CourseOutcome    @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  programmeOutcome ProgrammeOutcome @relation(fields: [programmeOutcomeId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([courseOutcomeId, programmeOutcomeId])
  @@index([institutionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ACADEMIC RESULTS — GRADING, SGPA, CGPA  (T-403)
//
// THE DEFECT THIS REPLACES
//
// `StudentProfile.cgpa` was a stored Float that NOTHING computed. The old code
// wrote a literal `cgpa: 8.5` for any user without a profile — fabricated
// academic data. Phase 0 removed the fabrication and left it at 0, which was
// correct but not useful: the system still could not produce a defensible
// transcript, and NIRF "Graduation Outcomes" was underivable.
//
// CGPA is now DERIVED. It is computed from Enrollment grades and Course credits
// through the institution's own grading scheme, and recomputed rather than
// trusted. The stored column becomes a cache of a calculation, not a claim.
//
// CONFIGURABLE, NOT HARD-CODED (audit rule 41)
//
// Indian institutions use different schemes — 10-point, 4-point, percentage,
// absolute vs relative grading. The blueprint expects campuses to differ. So
// the scale is data, and VERSIONED (audit rule 64) so a transcript issued in
// 2024 remains interpretable under the rules in force in 2024 even after the
// institution changes its scheme.
// ═══════════════════════════════════════════════════════════════════════════

/// A versioned grading scheme belonging to an institution.
model GradeScale {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  code     String
  name     String
  /// Maximum grade point, e.g. 10 for a 10-point scale, 4 for a 4-point scale.
  maxPoint Float  @default(10)

  /// Minimum grade point that counts as a pass.
  passingPoint Float @default(4)

  /// Version, so historical results stay interpretable after a scheme change.
  version String @default("1.0")

  effectiveFrom DateTime 
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bands           GradeBand[]
  semesterResults SemesterResult[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code, version])
  @@index([institutionId])
  @@index([isActive])
}

/// One band within a scale, e.g. "A+ = 9 points, 85-89 marks".
model GradeBand {
  id      String @id @default(uuid()) @map("_id")
  scaleId String

  /// Letter grade as it appears on a transcript.
  letter String
  /// Grade point contributed to SGPA/CGPA.
  point  Float

  /// Mark range this band covers. Inclusive lower, inclusive upper.
  minMarks Float
  maxMarks Float

  /// False for F/absent/withheld — excluded from earned credits.
  isPassing         Boolean @default(true)
  /// True for W/I/AB — excluded from the SGPA denominator entirely.
  isExcludedFromGpa Boolean @default(false)

  description String?

  scale GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, letter])
  @@index([scaleId])
}

/// A student's result for one course in one semester.
///
/// Separate from `Enrollment.grade` deliberately: the enrolment holds the
/// current working grade, this holds the PUBLISHED result with the grade point
/// and the scale that produced it, frozen at publication.
model CourseResult {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  studentProfileId String
  courseId         String
  semester         Int
  academicYear     String

  /// Component marks. Null where an institution records grades directly.
  internalMarks Float?
  externalMarks Float?
  totalMarks    Float?
  maxMarks      Float?

  /// Awarded grade and the point it carried under the scale in force.
  letterGrade String
  gradePoint  Float
  credits     Int

  isPassing         Boolean @default(true)
  isExcludedFromGpa Boolean @default(false)

  /// Attempt number — supplementary and revaluation create later attempts.
  attempt Int @default(1)

  /// draft | submitted | verified | moderated | published | revalued | withheld
  status String @default("draft")

  publishedAt DateTime?
  publishedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history GradeHistory[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([studentProfileId, courseId, attempt])
  @@index([institutionId])
  @@index([studentProfileId])
  @@index([courseId])
  @@index([status])
  @@index([studentProfileId, semester])
}

/// A student's SGPA for one semester, and the CGPA as at that semester.
///
/// Stored as a computed SNAPSHOT so a published result is reproducible, and so
/// multi-year reporting (NIRF requires three preceding years) does not depend
/// on recomputing history under today's rules.
model SemesterResult {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  studentProfileId String
  semester         Int
  academicYear     String

  /// The scale used, so this result stays interpretable after a scheme change.
  gradeScaleId String

  creditsRegistered Int
  creditsEarned     Int

  /// Semester GPA — Σ(gradePoint × credits) / Σ(credits) for GPA-eligible courses.
  sgpa Float
  /// Cumulative GPA across all semesters up to and including this one.
  cgpa Float

  /// Cumulative totals, retained so CGPA is auditable without replaying history.
  cumulativeCreditsRegistered Int
  cumulativeCreditsEarned     Int

  /// pass | fail | promoted | detained | withheld
  resultStatus String @default("pass")

  /// Rank within the batch, when the institution publishes ranks.
  batchRank Int?

  /// draft | published | revised
  status      String    @default("draft")
  publishedAt DateTime?
  publishedBy String?

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gradeScale GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([studentProfileId, semester, academicYear])
  @@index([institutionId])
  @@index([studentProfileId])
  @@index([status])
}

/// Immutable record of every change to a published academic result (T-104).
///
/// THE GAP THIS CLOSES: grades were mutated with no old value, no actor, no
/// reason and no approver — `faculty.ts` wrote `data: { grade: m.grade }`
/// directly. A faculty member could alter a published grade and leave no trace.
/// For a system subject to accreditation and legal scrutiny that is
/// disqualifying.
///
/// Rows are written INSIDE the same transaction as the change. A grade change
/// that cannot be recorded does not commit.
model GradeHistory {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  courseResultId String

  /// Before and after — so the change is fully reconstructable.
  oldLetterGrade String?
  newLetterGrade String
  oldGradePoint  Float?
  newGradePoint  Float
  oldTotalMarks  Float?
  newTotalMarks  Float?

  /// MANDATORY for a post-publication change. This is the field that makes the
  /// record defensible rather than merely present.
  reason String

  /// initial | correction | revaluation | supplementary | moderation | withdrawal
  changeType String @default("correction")

  changedBy String
  changedAt DateTime @default(now())

  /// Second signature. Post-publication changes should not be unilateral.
  approvedBy String?
  approvedAt DateTime?

  ipAddress String?

  courseResult CourseResult @relation(fields: [courseResultId], references: [id], onDelete: Restrict)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([courseResultId])
  @@index([changedAt])
  @@index([changedBy])
}

// ═══════════════════════════════════════════════════════════════════════════
// FILE MANAGEMENT (A5 / T-209)
//
// Phase 0 removed the unauthenticated `express.static('/uploads')` mount that
// made every uploaded file publicly downloadable. But it left a gap that was
// documented at the time: with no file metadata, ANY authenticated user could
// download ANY file whose id they knew.
//
// This model closes it. Every file now records its owner, its institution, who
// may read it, and what it belongs to — so access is a decision, not a guess.
//
// It also decouples storage from the filesystem. Uploads currently live on
// ephemeral local disk: lost on redeploy, unreachable from a second instance,
// and absent from `mongodump` backups. `storageKey` + `storageProvider` let the
// same record point at local disk today and object storage tomorrow.
// ═══════════════════════════════════════════════════════════════════════════

model FileMetadata {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String?

  /// Opaque key within the storage provider. NOT a filesystem path — the
  /// provider decides how to resolve it.
  storageKey      String
  /// local | s3
  storageProvider String @default("local")

  /// Functional area, used for organisation and access rules.
  module String

  originalName String
  mimeType     String
  sizeBytes    Int
  /// SHA-256, so corruption and duplicate uploads are both detectable.
  checksum     String?

  // ── Access control ────────────────────────────────────────────────────────

  /// Who uploaded it. Always permitted to read their own upload.
  uploadedBy String

  /// Subject of the file, when different from the uploader — e.g. a student's
  /// certificate uploaded by the registrar. The subject may always read it.
  ownerUserId String?

  /// private          — uploader, owner and institution admins only
  /// role_restricted  — additionally, roles listed in allowedRoles
  /// institution      — any authenticated member of the institution
  visibility String @default("private")

  /// Roles permitted when visibility = role_restricted.
  allowedRoles Json?

  /// Heightened handling: vigilance files, anonymous grievance evidence,
  /// disciplinary records. Never widened to `institution`.
  isConfidential Boolean @default(false)

  // ── Linkage ───────────────────────────────────────────────────────────────

  /// What the file belongs to, e.g. ('AdmissionApplication', '<uuid>').
  /// Deliberately a soft reference: files attach to many entity types, and a
  /// polymorphic FK is not expressible here.
  relatedEntityType String?
  relatedEntityId   String?

  // ── Lifecycle ─────────────────────────────────────────────────────────────

  /// Soft delete. Institutional records must not vanish on a mistaken click.
  deletedAt DateTime?
  deletedBy String?

  /// Retention support — nullable means "no expiry set".
  retainUntil DateTime?

  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([institutionId, storageKey])
  @@index([institutionId])
  @@index([module])
  @@index([uploadedBy])
  @@index([relatedEntityType, relatedEntityId])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// ADMISSIONS
//
// Blueprint workflow:
//   Enquiry → Application → Document Upload → Verification → Eligibility
//   → Merit → Selection → Admission Approval → Payment
//   → Student Record Creation → Enrollment
//
// "Do not treat admission as a basic CRUD table."
//
// NOTHING of this existed. The system had no way to admit a student — in
// practice students appeared via the fabrication that Phase 0 removed, or via
// the seed script. This is the single largest functional gap in the audit.
//
// Seat allocation by reservation category is STATUTORY in India and had no
// representation at all.
// ═══════════════════════════════════════════════════════════════════════════

/// An admission cycle for one programme in one academic year.
/// Blueprint: "each campus could run its own admission process (with unique
/// programs or quotas)" — hence campus scoping.
model AdmissionCycle {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String?
  programmeId   String

  academicYear String
  name         String
  code         String

  applicationStartsAt DateTime
  applicationEndsAt   DateTime

  /// Total sanctioned intake. Seat-matrix rows must sum to this.
  totalSeats Int

  /// Application fee, if any.
  applicationFee Float @default(0)

  /// Minimum qualifying marks (%) for eligibility screening.
  minimumQualifyingPercentage Float?
  /// Entrance exam this cycle accepts, e.g. "JEE Main", "CUET".
  entranceExamName            String?

  /// draft | open | closed | merit_published | admissions_closed | cancelled
  status String @default("draft")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme    Programme              @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  seatMatrix   AdmissionSeatMatrix[]
  applications AdmissionApplication[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([programmeId])
  @@index([status])
}

/// Seats reserved per category for a cycle.
///
/// Reservation is a legal requirement, not a preference. Allocating a seat
/// without checking the category's remaining count would over-admit against a
/// statutory quota, so `filledSeats` is incremented inside the same transaction
/// that creates the offer.
model AdmissionSeatMatrix {
  id      String @id @default(uuid()) @map("_id")
  cycleId String

  /// GENERAL | EWS | OBC_NCL | SC | ST | PWD | MINORITY
  category String

  totalSeats  Int
  filledSeats Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /// Bumped by lockForUpdate() to claim the document inside a transaction —
  /// the MongoDB counterpart of SELECT … FOR UPDATE. Never read by business logic.
  lockVersion Int @default(0)


  @@unique([cycleId, category])
  @@index([cycleId])
}

/// A candidate's application. The applicant has NO user account at this stage —
/// an account is created only on admission confirmation.
model AdmissionApplication {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  cycleId       String

  /// Human-facing reference, e.g. APP-2026-000123.
  applicationNumber String

  // ── Applicant identity ────────────────────────────────────────────────────
  fullName    String
  email       String
  phone       String
  dateOfBirth DateTime

  /// Demographics. Reservation category drives statutory seat allocation;
  /// gender/state feed NIRF "OI" and UGC equity reporting.
  /// ⚠ Collection is subject to DPDP purpose-limitation review (T-407).
  gender             String?
  category           String  @default("GENERAL")
  domicileState      String?
  nationality        String? @default("Indian")
  isDifferentlyAbled Boolean @default(false)

  guardianName  String?
  guardianPhone String?
  addressLine   String?
  city          String?
  state         String?
  pincode       String?

  // ── Prior academic record (eligibility + merit) ───────────────────────────
  previousQualification String?
  previousBoard         String?
  previousInstitution   String?
  previousYearOfPassing Int?
  previousPercentage    Float?

  entranceExamRollNumber String?
  entranceExamScore      Float?
  entranceExamRank       Int?

  /// Computed merit score. Null until merit generation runs.
  meritScore Float?
  meritRank  Int?

  /// Eligibility screening outcome, with the reason recorded so a rejected
  /// candidate can be told why — and so the decision is auditable.
  isEligible        Boolean?
  eligibilityRemark String?

  /// submitted | under_verification | verified | rejected | eligible
  /// | shortlisted | offered | accepted | declined | admitted | withdrawn | expired
  status String @default("submitted")

  submittedAt     DateTime  @default(now())
  verifiedBy      String?
  verifiedAt      DateTime?
  decidedBy       String?
  decidedAt       DateTime?
  rejectionReason String?

  applicationFeePaid Boolean @default(false)
  applicationFeeRef  String?

  /// Set once the application converts into a real student record.
  studentProfileId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle     AdmissionCycle      @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  documents AdmissionDocument[]
  offers    AdmissionOffer[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  studentProfile StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: SetNull)

  @@unique([institutionId, applicationNumber])
  @@index([institutionId])
  @@index([cycleId])
  @@index([status])
  @@index([cycleId, category])
  @@index([email])
}

/// Uploaded supporting document with its verification trail.
/// Blueprint: "Track submission and verification of required documents".
model AdmissionDocument {
  id            String @id @default(uuid()) @map("_id")
  applicationId String

  /// marksheet | transfer_certificate | migration | category_certificate
  /// | income_certificate | disability_certificate | photo | id_proof | other
  documentType  String
  fileName      String
  fileUrl       String
  mimeType      String?
  fileSizeBytes Int?

  /// pending | verified | rejected
  verificationStatus String    @default("pending")
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?

  uploadedAt DateTime @default(now())

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([verificationStatus])
}

/// A seat offer made to a candidate, with an expiry.
///
/// A seat held by an unresponsive candidate blocks the next in merit order, so
/// offers expire and the seat returns to its category pool.
model AdmissionOffer {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  applicationId String

  /// The category pool this seat came from — needed to return it on decline.
  seatCategory String

  offeredAt DateTime @default(now())
  expiresAt DateTime
  offeredBy String

  /// pending | accepted | declined | expired | withdrawn
  status String @default("pending")

  respondedAt DateTime?

  /// Admission fee due on acceptance.
  admissionFeeAmount Float?
  admissionFeePaid   Boolean @default(false)
  admissionFeeRef    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([applicationId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// GOVERNANCE & NAAC CRITERION 6 EVIDENCE
//
// Blueprint: "Universities operate many committees (IQAC, Academic Council,
// Boards of Studies, Governing Body, anti-ragging committee, grievance
// committee, etc.). The ERP provides a committee module… This creates a
// repository that is invaluable during NAAC visits (to demonstrate periodic
// meetings and actions taken)."
//
// None of this existed. A `Committee` model was present but was a per-faculty
// membership counter with no institution, no meetings, and no minutes — it
// could not serve as governance evidence.
// ═══════════════════════════════════════════════════════════════════════════

/// A statutory or institutional committee.
model GovernanceCommittee {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String?

  code String
  name String
  /// iqac | academic_council | board_of_studies | governing_body |
  /// anti_ragging | grievance | internal_complaints | finance | library | other
  type String

  /// Why the committee exists — quoted directly in accreditation evidence.
  purpose          String?
  /// Statutory basis, e.g. "UGC Anti-Ragging Regulations 2009".
  constitutedUnder String?

  /// How often it is REQUIRED to meet. Enables a compliance check of
  /// "did this committee actually meet as often as it must?"
  meetingFrequency String? // monthly | quarterly | half_yearly | annually | as_needed

  constitutedOn DateTime?
  dissolvedOn   DateTime?
  isActive      Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  CommitteeMember[]
  meetings CommitteeMeeting[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([type])
}

/// Committee membership with tenure — NAAC asks who served, in what role, when.
model CommitteeMember {
  id          String @id @default(uuid()) @map("_id")
  committeeId String

  /// Internal member. Null for external/nominated members, who are named below.
  userId              String?
  /// External members (industry, alumni, parent, student nominee) have no account.
  externalName        String?
  externalAffiliation String?

  /// chairperson | member_secretary | member | special_invitee | external_expert
  role String @default("member")

  tenureFrom DateTime 
  tenureTo   DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())

  committee GovernanceCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([committeeId])
  @@index([userId])
}

/// A committee meeting with agenda, attendance, minutes and resolutions.
///
/// Blueprint: "schedules meetings, circulates agenda, and archives
/// minutes/resolutions… demonstrating what decisions were made and by whom."
model CommitteeMeeting {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  committeeId   String

  /// Sequential within the committee, e.g. "IQAC/2026/03".
  meetingNumber String
  title         String
  scheduledAt   DateTime 
  heldAt        DateTime?
  venue         String?
  isOnline      Boolean   @default(false)

  agenda     Json?
  /// Present / absent / leave-of-absence, recorded per member — quorum evidence.
  attendance Json?

  /// Minutes as recorded, and the approval trail NAAC expects.
  minutes         String?
  minutesApproved Boolean   @default(false)
  approvedBy      String?
  approvedAt      DateTime?

  /// Resolutions passed, each with an owner and due date so that
  /// "action taken" can be demonstrated rather than asserted.
  resolutions Json?

  /// scheduled | held | cancelled | postponed
  status String @default("scheduled")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  committee GovernanceCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([committeeId, meetingNumber])
  @@index([institutionId])
  @@index([committeeId])
  @@index([scheduledAt])
}

/// Institutional policy repository.
///
/// Blueprint: "A repository for all institutional policies, circulars, and
/// protocols… NAAC often asks for such documents."
///
/// VERSIONED, because historical records must remain interpretable under the
/// policy that was in force at the time (audit rule 64). Superseding a policy
/// does not delete its predecessor.
model InstitutionalPolicy {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String?

  code     String
  title    String
  /// academic | examination | hr | finance | student_welfare | it |
  /// research | admission | governance | anti_ragging | grievance | other
  category String

  version            String  @default("1.0")
  /// Points at the policy this one replaces, preserving the chain.
  supersedesPolicyId String?

  summary String?
  /// Full text, or a reference to an uploaded document.
  content String?
  fileUrl String?

  /// Governance trail — who approved it and under what authority.
  approvedBy    String?
  approvedAt    DateTime?
  approvingBody String? // e.g. "Academic Council", "Board of Management"

  effectiveFrom DateTime 
  effectiveTo   DateTime?
  reviewDueOn   DateTime?

  /// Whether the policy must be publicly disclosed (UGC mandatory disclosure).
  isPublic Boolean @default(false)

  /// draft | under_review | approved | superseded | withdrawn
  status String @default("draft")

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@unique([institutionId, code, version])
  @@index([institutionId])
  @@index([category])
  @@index([status])
}

// Admin — Backup Records
model BackupRecord {
  id          String   @id @default(uuid()) @map("_id")
  type        String
  size        String
  createdDate DateTime @default(now())
  status      String   @default("in_progress")
  duration    String?
  initiatedBy String
  location    String
}

// ═══════════════════════════════════════════════════════════════════════════
// BULK IMPORT
//
// No institution can onboard onto this system without loading its existing
// records — students, faculty, courses — from whatever it has now, which is
// almost always spreadsheets exported from a previous system or maintained by
// hand.
//
// THE DESIGN CONSTRAINT THAT SHAPES EVERYTHING HERE: an import that half-works
// is worse than one that fails. A partially-loaded student roll leaves the
// registrar unable to tell which records are real, and the usual "fix" is to
// delete everything and start over — which is only possible if nothing has
// referenced the new rows yet.
//
// So: every import is VALIDATED IN FULL before anything is written, runs in a
// single transaction, and can be previewed without writing at all.
// ═══════════════════════════════════════════════════════════════════════════

/// One import run.
model ImportJob {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  /// students | faculty | courses | departments
  entityType String

  fileName    String
  /// Bytes, recorded so an aborted upload is distinguishable from a small file.
  fileSize    Int
  /// SHA-256 of the uploaded content. Re-uploading the SAME file is detected
  /// and refused rather than silently duplicating a roll.
  contentHash String

  /// pending | validating | validated | importing | completed | failed | cancelled
  status String @default("pending")

  /// True when this run only reported what WOULD happen.
  dryRun Boolean @default(false)

  totalRows    Int @default(0)
  validRows    Int @default(0)
  errorRows    Int @default(0)
  importedRows Int @default(0)
  /// Rows skipped because the record already existed.
  skippedRows  Int @default(0)

  /// Populated when the whole job failed, as opposed to individual rows.
  failureReason String?

  startedBy   String
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  errors ImportError[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([status])
  @@index([institutionId, contentHash])
}

/// One problem with one row.
///
/// A separate table rather than a JSON column on the job: a 50,000-row file
/// with a systematic error (a mis-mapped column) produces 50,000 messages, and
/// a JSON blob that size is neither queryable nor safely loadable into memory.
model ImportError {
  id    String @id @default(uuid()) @map("_id")
  jobId String

  /// 1-based line number AS IT APPEARS IN THE FILE, including the header, so it
  /// matches what the operator sees in their spreadsheet.
  rowNumber Int
  /// Column name where determinable.
  column    String?
  /// The offending value, truncated. Never contains a password.
  value     String?

  /// validation | duplicate | reference_not_found | conflict | system
  errorType String
  message   String

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, rowNumber])
}

// ═══════════════════════════════════════════════════════════════════════════
// OBE ATTAINMENT — ASSESSMENTS AND CO-WISE MARKS
//
// WHY THESE TABLES HAD TO EXIST FIRST
//
// The CO/PO/PSO models and CoPoMapping were added in 0007, but nothing linked
// STUDENT MARKS to a course outcome. `CourseResult` records only course totals
// (internal / external / total).
//
// You cannot compute CO attainment from a course total. The tempting shortcut —
// distribute a student's total equally across that course's COs — produces
// numbers that look like attainment and mean nothing: every CO would attain
// identically by construction, and the resulting figure could end up in an NBA
// submission. That is the fabrication pattern this project has spent its whole
// effort removing.
//
// So attainment is computed from marks recorded AGAINST outcomes.
// ═══════════════════════════════════════════════════════════════════════════

/// One assessment event for a course under a curriculum scheme.
model Assessment {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  schemeCourseId String
  academicYear   String
  /// Optional section, so two sections of one course can be assessed separately.
  sectionId      String?

  name String
  /// CIE | SEE | ASSIGNMENT | LAB | PROJECT | SEMINAR | VIVA
  type String

  maxMarks      Float
  /// Share of the course's internal evaluation, for the gradebook. NOT used in
  /// attainment: attainment weights come from the CO-wise mark distribution.
  weightPercent Float @default(0)

  conductedOn DateTime?

  /// draft | published
  /// Marks are only counted toward attainment once published.
  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcomes AssessmentOutcome[]
  marks    AssessmentCoMark[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  schemeCourse SchemeCourse @relation(fields: [schemeCourseId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([schemeCourseId])
  @@index([academicYear])
  @@index([status])
}

/// CO-wise mark distribution for an assessment.
///
/// "Of this 50-mark test, 20 marks assess CO1 and 30 assess CO2." The sum is
/// validated against `Assessment.maxMarks` — a distribution that does not add up
/// silently distorts every attainment figure derived from it.
model AssessmentOutcome {
  id           String @id @default(uuid()) @map("_id")
  assessmentId String

  courseOutcomeId String
  maxMarks        Float

  createdAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Declared to match migration 0015, which creates this constraint with
  /// ON DELETE CASCADE. The schema did not describe it, so the next
  /// `migrate dev` would have DROPPED a foreign key the database relies on.
  courseOutcome CourseOutcome @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, courseOutcomeId])
  @@index([courseOutcomeId])
}

/// A student's marks on one assessment, for one course outcome.
///
/// Per-CO rather than per-assessment, because that is the granularity
/// attainment actually requires. Recording only an assessment total and
/// splitting it later is the approximation this model exists to avoid.
model AssessmentCoMark {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  assessmentId  String

  studentProfileId String
  courseOutcomeId  String

  marksObtained Float

  /// Absent students are EXCLUDED from attainment rather than counted as zero.
  /// Counting an absence as a zero depresses a CO's attainment for a reason
  /// that has nothing to do with whether the outcome was taught successfully.
  isAbsent Boolean @default(false)

  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Declared to match migration 0015, which creates this constraint with
  /// ON DELETE CASCADE. The schema did not describe it, so the next
  /// `migrate dev` would have DROPPED a foreign key the database relies on.
  courseOutcome  CourseOutcome  @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// `map` pins the name PostgreSQL actually gave this index. Migration
  /// 0015 asked for "..._courseOutcomeId_key", which exceeds the 63-character
  /// identifier limit and was truncated to "..._courseOutcomeId_". Prisma
  /// truncates differently ("..._courseOutcom_key"), so without this the two
  /// disagree forever and every drift check reports a phantom rename.
  @@unique([assessmentId, studentProfileId, courseOutcomeId], map: "AssessmentCoMark_assessmentId_studentProfileId_courseOutcomeId_")
  @@index([institutionId])
  @@index([studentProfileId])
  @@index([courseOutcomeId])
}

/// Indirect attainment — course-exit surveys, employer or alumni feedback.
///
/// Recorded, never inferred. When no record exists for a CO, attainment is
/// reported as DIRECT ONLY and labelled as such, rather than quietly treating
/// the direct figure as the whole picture.
model IndirectAttainment {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  courseOutcomeId String
  academicYear    String

  /// e.g. "Course exit survey"
  source      String
  /// Attainment level on the institution's scale, typically 0-3.
  level       Float
  /// How many responses this is based on — a level from 3 respondents is not
  /// the same evidence as one from 300.
  respondents Int    @default(0)

  recordedBy String
  createdAt  DateTime @default(now())

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  /// Declared to match migration 0015, which creates this constraint with
  /// ON DELETE CASCADE. The schema did not describe it, so the next
  /// `migrate dev` would have DROPPED a foreign key the database relies on.
  courseOutcome CourseOutcome @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)

  @@unique([courseOutcomeId, academicYear, source])
  @@index([institutionId])
}

/// Institution's attainment policy.
///
/// Every number here is INSTITUTIONAL POLICY, not a standard. NBA does not
/// mandate specific thresholds; each institution sets and publishes its own in
/// its OBE manual. Hardcoding "60% of students clearing 60% = level 3" would
/// silently impose one institution's convention on every other, and produce
/// figures the institution could not defend to an assessor.
model ObeAttainmentPolicy {
  id            String @id @default(uuid()) @map("_id")
  institutionId String @unique

  /// A student is deemed to have attained a CO at or above this percentage.
  studentTargetPercent Float @default(60)

  /// Percentage of students that must reach the target for each level.
  level3Percent Float @default(70)
  level2Percent Float @default(60)
  level1Percent Float @default(50)

  /// Direct/indirect blend. Must sum to 100.
  directWeight   Float @default(80)
  indirectWeight Float @default(20)

  /// Highest level on the scale, for normalising PO attainment.
  maxLevel Float @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKFLOW ENGINE (Phase 2.2)
//
// The Phase 2.1 catalogue found approvals implemented three different ways:
// a boolean flag on an entity (`CurriculumProposal.bosApproved`), a row in a
// shared queue (`ApprovalItem`), and a multi-step sequence spanning modules
// (result publication: HOD verifies -> CoE requests -> Dean publishes). It also
// found handlers creating records already marked approved, which are activity
// log entries rather than decisions.
//
// THE DESIGN CHOICE: the TRANSITION LOG is the primary record, not a status
// column. A status column tells you where something is; it cannot tell you how
// it got there, who moved it, or what they were told at the time. For an
// institutional approval — a fee waiver, a grade change, a promotion — the
// second question is the one an auditor actually asks.
//
// `WorkflowInstance.currentStepId` is therefore a CACHE of the latest
// transition, not the source of truth. It exists so the common query ("what is
// waiting on me?") is one indexed read rather than a fold over history.
// ═══════════════════════════════════════════════════════════════════════════

/// A named, versioned approval process an institution defines for itself.
model WorkflowDefinition {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  /// Stable identifier used by code, e.g. `FEE_WAIVER`.
  code        String
  name        String
  description String?

  /// What this process approves — `FeeWaiver`, `GradeChange`, `Promotion`.
  /// Free text rather than an enum: an institution may define a process for
  /// something this codebase has no model for.
  entityType String

  /// Definitions are VERSIONED and never edited in place. An instance keeps the
  /// version it started under, so changing the process tomorrow cannot rewrite
  /// what was approved yesterday.
  version Int     @default(1)
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@unique([institutionId, code, version])
  @@index([institutionId])
  @@index([entityType])
}

/// One stage in a definition.
model WorkflowStep {
  id           String @id @default(uuid()) @map("_id")
  definitionId String

  /// Order within the definition. Not a foreign key to the next step, because a
  /// rejection may jump backwards and an escalation may skip ahead.
  sequence Int
  name     String

  /// Who may act at this step. A role rather than a person: staff change, and a
  /// process pinned to an individual stops working when they leave.
  assigneeRole String

  /// Who this step falls to when `slaHours` is breached. NULL means it does not
  /// escalate: the deadline is still reported, but the approval stays put.
  /// Escalating a decision to someone without the standing to make it is worse
  /// than leaving it late.
  escalationRole String?

  /// Where an approval goes next. NULL means this step completes the workflow.
  onApproveStepId String?
  /// Where a rejection goes. NULL means the workflow ends as rejected.
  onRejectStepId  String?

  /// Hours before this step is considered overdue. Escalation is not automated
  /// yet — there is no scheduler — so this is recorded and reported, not acted
  /// upon. Stating that here so it is not mistaken for a working SLA.
  slaHours Int?

  createdAt DateTime @default(now())

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, sequence])
  @@index([definitionId])
}

/// A running (or finished) execution of a definition against one entity.
model WorkflowInstance {
  id            String @id @default(uuid()) @map("_id")
  institutionId String

  definitionId String
  /// The record under approval. Polymorphic by necessity — the engine approves
  /// things it has no model for — so this deliberately carries NO foreign key.
  entityType   String
  entityId     String

  /// Cache of the latest transition's destination. See the note above: the
  /// transition log is authoritative.
  currentStepId String?

  /// pending | approved | rejected | cancelled
  status String @default("pending")

  startedBy String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  /// Recorded on the INSTANCE, not the step: escalation is a fact about this
  /// particular approval, not about the process definition.
  escalatedAt       DateTime?
  escalatedFromRole String?

  /// Free-form context for the approver — amount, reason, links.
  context Json?

  definition  WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  transitions WorkflowTransition[]
  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Queue rows projecting this instance (Phase 2.4).
  approvalItems ApprovalItem[]

  @@index([institutionId])
  /// Declared to match migration 0032.
  @@index([escalatedAt])
  @@index([status])
  @@index([entityType, entityId])
  @@index([institutionId, status])
}

/// One recorded decision. APPEND ONLY — never updated, never deleted.
///
/// This is the audit trail for approvals. A transition that could be edited
/// afterwards would not be evidence of anything.
model WorkflowTransition {
  id         String @id @default(uuid()) @map("_id")
  instanceId String

  fromStepId String?
  toStepId   String?

  /// started | approved | rejected | forwarded | cancelled
  action String

  actorId   String
  actorRole String
  note      String?

  occurredAt DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([occurredAt])
}

/// Rate-limit counters, shared by every application instance.
///
/// Deliberately NOT tenant-scoped: the login throttle counts attempts against
/// an IP and a submitted email BEFORE anyone is authenticated, so there is no
/// institution to attribute them to yet. It is also not something one tenant
/// should be able to read about another. It carries no personal data beyond
/// the key itself, which is why it is safe to prune wholesale.
model RateLimitWindow {
  /// "<limiter>:<ip>:<email>" — opaque to the database.
  key     String   @id @map("_id")
  count   Int
  /// When this window expires. Set by whichever instance opens the window so
  /// that every instance agrees on the end, rather than each extending it.
  resetAt DateTime

  @@index([resetAt])
}

/// Self-service password reset (T-auth-reset).
///
/// Only the SHA-256 of the raw token is ever stored — the same discipline as
/// `User.password`, applied here because a leaked reset-token table must not
/// itself become a way to take over accounts. The raw token exists only in
/// the one email sent to the account holder.
///
/// No `institutionId`: like `RateLimitWindow`, this exists before any tenant
/// context is resolved, and `userId` alone is sufficient to reach the right
/// account. `onDelete: Cascade` — an outstanding reset token for a deleted
/// user is meaningless, not an orphan worth investigating.
model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime 
  /// Set when the token is consumed. A used token is never valid again, even
  /// if `expiresAt` has not passed — reuse is exactly what a leaked link (in
  /// a mail log, a browser history, a forwarded message) would attempt.
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One class taken by another teacher on one date — the HOD's cover for a
/// faculty member on leave. The substitute sees the class that day and can
/// post its attendance; the regular timetable is unchanged.
model ClassSubstitution {
  id                  String   @id @default(uuid()) @map("_id")
  institutionId       String
  courseId            String
  /// The CourseSchedule slot being covered.
  scheduleId          String
  /// Midnight UTC of the class date, like AttendanceSession.date.
  date                DateTime
  startTime           String
  endTime             String
  originalFacultyId   String?
  substituteFacultyId String
  reason              String?
  createdBy           String
  createdAt           DateTime @default(now())

  @@unique([scheduleId, date])
  @@index([institutionId, date])
  @@index([substituteFacultyId, date])
}

/// A student's application for a fee waiver / scholarship / freeship against
/// one fee. Approved through SCHOLARSHIP_FEE_WAIVER (HOD → Dean → Finance);
/// on sanction the amount is written to FeeRecord.waivedAmount.
model FeeWaiverRequest {
  id               String    @id @default(uuid()) @map("_id")
  institutionId    String
  studentProfileId String
  feeRecordId      String
  /// merit | need_based | sc_st_freeship | sports | single_girl_child | other
  category         String
  requestedAmount  Float
  reason           String
  /// Supporting document (income / category certificate, mark sheet …), an /api/uploads URL.
  documentUrl      String?
  documentName     String?
  /// pending | approved | rejected | cancelled
  status           String    @default("pending")
  appliedAt        DateTime  @default(now())
  decidedAt        DateTime?
  /// What Finance actually waived — capped at what was still owed.
  sanctionedAmount Float?

  @@index([institutionId, studentProfileId])
  @@index([feeRecordId])
}

/// A timetable or subject-allocation change the HOD has asked for. It waits
/// for the Dean (TIMETABLE_WORKLOAD_APPROVAL) and is applied on approval.
model TimetableChange {
  id            String    @id @default(uuid()) @map("_id")
  institutionId String
  departmentId  String
  courseId      String
  /// slot_create | slot_update | slot_delete | allocation
  kind          String
  /// "slot:<scheduleId>" or "allocation:<courseId>" — one open request each.
  target        String?
  /// The change itself: { slot?, scheduleId?, courseId?, facultyId? }
  payload       Json
  /// One line for the Dean, e.g. "Move CSE502 from Monday 09:00 (CSE-301) to …"
  summary       String
  /// pending | approved | applied | failed | rejected | cancelled
  status        String    @default("pending")
  failureReason String?
  requestedBy   String
  requestedAt   DateTime  @default(now())
  appliedAt     DateTime?

  @@index([institutionId, departmentId, status])
}


/// A student's leave, medical leave or on-duty request. Decided by the HOD
/// (STUDENT_LEAVE_OD). An approved on-duty request marks the student "on duty"
/// for classes in that period, which counts as present.
model StudentLeaveRequest {
  id               String    @id @default(uuid()) @map("_id")
  institutionId    String
  studentProfileId String
  /// leave | medical | on_duty
  type             String
  fromDate         DateTime
  toDate           DateTime
  reason           String
  documentUrl      String?
  /// pending | approved | rejected | cancelled
  status           String    @default("pending")
  decidedBy        String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())

  @@index([institutionId])
  @@index([studentProfileId])
}

/// A bus route with its stops. Each stop carries the yearly fee for boarding there.
model TransportRoute {
  id            String   @id @default(uuid()) @map("_id")
  institutionId String
  code          String
  name          String
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  capacity      Int      @default(50)
  /// [{ name, time, fee }]
  stops         Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([institutionId])
}

model TransportAllocation {
  id               String    @id @default(uuid()) @map("_id")
  institutionId    String
  routeId          String
  studentProfileId String
  stop             String
  fee              Float
  academicYear     String
  /// active | cancelled
  status           String    @default("active")
  feeRecordId      String?
  allocatedAt      DateTime  @default(now())
  allocatedBy      String?

  @@index([institutionId])
  @@index([routeId])
  @@index([studentProfileId])
}

/// A student asking for a hostel seat or a bus pass; the Registrar's office
/// allocates (which raises the fee) or declines.
model CampusServiceRequest {
  id               String    @id @default(uuid()) @map("_id")
  institutionId    String
  studentProfileId String
  /// hostel | transport
  service          String
  /// hostel: { roomType }, transport: { routeId, stop }
  preference       Json?
  note             String?
  /// requested | allocated | declined | cancelled
  status           String    @default("requested")
  decidedBy        String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())

  @@index([institutionId])
  @@index([studentProfileId])
}

/// A staff member's pay structure; monthly payroll is generated from it.
model SalaryStructure {
  id              String   @id @default(uuid()) @map("_id")
  institutionId   String
  userId          String
  employeeId      String
  basic           Float
  /// Dearness allowance, % of basic
  daPercent       Float    @default(0)
  /// House rent allowance, % of basic
  hraPercent      Float    @default(0)
  /// Other fixed monthly allowances (conveyance, special …)
  otherAllowances Float    @default(0)
  pfApplicable    Boolean  @default(true)
  ptApplicable    Boolean  @default(true)
  bankAccount     String?
  ifsc            String?
  pan             String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([institutionId, userId])
  @@index([institutionId])
}
