/// A campus or constituent college. Blueprint: "each campus could almost run as
/// an independent entity in the system, yet all data rolls up to the central
/// level for unified reporting".
model Campus {
  id            String @id @default(uuid()) @map("_id")
  institutionId String
  code          String
  name          String
  /// main | branch | constituent_college | affiliated_college | off_campus_centre
  type          String @default("main")

  addressLine String?
  city        String?
  state       String?
  pincode     String?

  /// Campus-level overrides (academic calendar, fee structure, local rules).
  /// Blueprint: "Allow certain configurations to vary by campus".
  settings Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  schools     School[]
  departments Department[]
  users       User[]

  // ── Back-relations added in 0019 ──
  admissionCycles       AdmissionCycle[]
  examSessions          ExamSession[]
  facultyProfiles       FacultyProfile[]
  fileMetadatas         FileMetadata[]
  governanceCommittees  GovernanceCommittee[]
  institutionalPolicies InstitutionalPolicy[]
  studentProfiles       StudentProfile[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  // Tenant-scoped uniqueness: two universities may both have a "MAIN" campus.
  @@unique([institutionId, code])
  @@index([institutionId])
}

/// A school or faculty grouping departments (e.g. School of Engineering).
/// Deans are scoped here.
model School {
  id            String  @id @default(uuid()) @map("_id")
  institutionId String
  campusId      String
  code          String
  name          String
  deanUserId    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  departments Department[]

  /// Added in 0019 — the column existed with nothing enforcing the target.
  deanUser User? @relation(fields: [deanUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([campusId])
}

/// An academic programme (B.Tech CSE, M.Sc Physics, PhD).
///
/// THE STRUCTURAL GAP THIS FIXES: `StudentProfile.program` was free text, so
/// curriculum, credit requirements, electives, prerequisites, honours and
/// multiple entry/exit were all unrepresentable. Every academic capability in
/// the roadmap depends on this model existing.
model Programme {
  id             String @id @default(uuid()) @map("_id")
  institutionId  String
  departmentId   String
  code           String
  name           String
  /// UG | PG | PHD | DIPLOMA | CERTIFICATE | INTEGRATED
  level          String
  /// Duration in years, and the number of semesters it spans.
  durationYears  Int
  totalSemesters Int

  /// Credit requirements — the basis of SGPA/CGPA and ABC credit transfer.
  totalCredits Int

  /// NEP 2020 multiple entry/exit support. Exit awards are defined as
  /// { afterYear, award } so a student leaving after year 1 receives a
  /// certificate, after year 2 a diploma, and so on.
  supportsMultipleExit Boolean @default(false)
  exitAwards           Json?

  /// Honours / honours-with-research variants (UGC four-year UG structure).
  hasHonours         Boolean @default(false)
  hasHonoursResearch Boolean @default(false)

  /// Sanctioned intake — a NIRF TLR input and a NAAC Criterion 2 metric.
  sanctionedIntake Int?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batches           Batch[]
  admissionCycles   AdmissionCycle[]
  curriculumSchemes CurriculumScheme[]

  // ── Back-relations added in 0019 ──
  studentProfiles StudentProfile[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
}

/// An admission cohort within a programme (e.g. B.Tech CSE 2024-28).
model Batch {
  id                     String @id @default(uuid()) @map("_id")
  institutionId          String
  programmeId            String
  code                   String
  name                   String
  admissionYear          Int
  expectedGraduationYear Int
  currentSemester        Int    @default(1)
  /// active | graduated | discontinued
  status                 String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  sections  Section[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  // ── Back-relations added in 0019 ──
  studentProfiles StudentProfile[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([institutionId, code])
  @@index([programmeId])
  @@index([institutionId])
}

/// A section within a batch (e.g. Section A). Class-level operations —
/// attendance, timetable, class messages — hang off this.
model Section {
  id                 String  @id @default(uuid()) @map("_id")
  institutionId      String
  batchId            String
  code               String
  name               String
  capacity           Int?
  classAdvisorUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  classAdvisorUser User? @relation(fields: [classAdvisorUserId], references: [id], onDelete: SetNull)

  // ── Back-relations added in 0019 ──
  assessments     Assessment[]
  studentProfiles StudentProfile[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([batchId, code])
  @@index([institutionId])
  @@index([batchId])
}

// User model to handle authentication and base information
model User {
  id String @id @default(uuid()) @map("_id")

  /// TENANT KEY. Nullable only during the tenancy backfill migration; it is
  /// populated for every row and treated as required by application code.
  /// Required since 0030. A NULLABLE tenant key is a hole in the filter: a
  /// NULL row matches no institution, so it becomes invisible and
  /// unrepairable rather than leaking.
  institutionId String
  /// Campus assignment. Null means the user is institution-wide (VC, Registrar).
  campusId      String?

  /// Login identifier — deliberately GLOBALLY unique, unlike other codes which
  /// are tenant-scoped. A person must resolve to exactly one account.
  email        String   @unique
  password     String
  name         String
  role         String
  avatar       String?
  departmentId String?
  designation  String?
  /// DEPRECATED — superseded by `campusId`. Retained so the backfill migration
  /// can read the old free-text value; drop once migration is confirmed.
  campus       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campusRef      Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  department     Department?     @relation(name: "UserDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  notifications  Notification[]
  alumniProfile  AlumniProfile?

  // ── Back-relations added in 0019 ──
  feedbackResponses          FeedbackResponse[]
  committeeMembers           CommitteeMember[]
  examSchedulesAsPaperSetter ExamSchedule[]         @relation("ExamSchedule_paperSetter")
  examSchedulesAsEvaluator   ExamSchedule[]         @relation("ExamSchedule_evaluator")
  fileMetadatas              FileMetadata[]
  grievanceCases             GrievanceCase[]
  iDCardRequests             IDCardRequest[]
  notificationDeliveries     NotificationDelivery[]
  patrolLogs                 PatrolLog[]
  schools                    School[]
  sections                   Section[]
  systemAuditLogs            SystemAuditLog[]
  departmentsHeaded          Department[]           @relation("DepartmentHod")
  passwordResetTokens        PasswordResetToken[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@index([institutionId])
  @@index([campusId])
  @@index([institutionId, role])
}

// Profile for Students
model StudentProfile {
  id     String @id @default(uuid()) @map("_id")
  userId String @unique

  /// TENANT KEY — blueprint: "Every student and staff profile is tagged with
  /// their respective campus".
  /// Required since 0030. A NULLABLE tenant key is a hole in the filter: a
  /// NULL row matches no institution, so it becomes invisible and
  /// unrepairable rather than leaking.
  institutionId String
  campusId      String?

  /// Structured hierarchy references, superseding the free-text fields below.
  programmeId String?
  batchId     String?
  sectionId   String?

  /// Roll number — tenant-scoped, not globally unique.
  rollNumber String

  // ── Legacy free-text fields ───────────────────────────────────────────────
  // Retained so the backfill migration can read existing values and so no data
  // is lost. New code must use programmeId / batchId / sectionId. These are
  // dropped once backfill is confirmed complete.
  program String
  branch  String
  section String
  batch   String

  semester      Int
  admissionYear Int

  /// DERIVED VALUES — must be COMPUTED from Enrollment.grade + Course.credits,
  /// never written directly. The previous code wrote a literal `cgpa: 8.5` for
  /// any user without a profile. Until the results engine (T-403) exists these
  /// stay 0 rather than being fabricated.
  cgpa          Float @default(0)
  totalCredits  Int   @default(0)
  earnedCredits Int   @default(0)

  // ── Demographics (NIRF "OI", UGC equity, AISHE) ───────────────────────────
  // Blueprint: "The SIS will capture demographics (state, country, gender,
  // category) and produce diversity reports."
  //
  // ⚠ COLLECTION IS GATED ON LEGAL REVIEW (T-407). These columns exist so the
  // reporting architecture is not blocked, but category/disability data must
  // not be collected until DPDP purpose-limitation, consent and retention are
  // settled with counsel. Nullable by design.
  gender             String?
  dateOfBirth        DateTime?
  category           String?
  domicileState      String?
  nationality        String?   @default("Indian")
  isDifferentlyAbled Boolean   @default(false)
  isHosteller        Boolean   @default(false)
  /// Contact and family details the student maintains (Profile → Edit).
  /// Name, date of birth, category and similar official fields are changed
  /// only through a Registrar record correction.
  phone              String?
  alternatePhone     String?
  personalEmail      String?
  bloodGroup         String?
  /// { line1, line2, city, state, pincode, country }
  permanentAddress   Json?
  currentAddress     Json?
  /// { fatherName, fatherOccupation, fatherPhone, fatherEmail, motherName, motherOccupation, motherPhone }
  guardian           Json?

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  classEnrollments ClassEnrollment[]
  submissions      Submission[]
  attendance       Attendance[]
  feeRecords       FeeRecord[]
  gatePasses       GatePass[]
  applications     StudentApplication[]
  // Copies are no longer owned by a student; borrowing is a LibraryLoan.
  libraryLoans     LibraryLoan[]
  certificates     CertificateRequest[]
  hostel           HostelAllocation?

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  batchRef Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  programme Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  sectionRef Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // ── Back-relations added in 0019 ──
  admissionApplications AdmissionApplication[]
  antiRaggingAffidavits AntiRaggingAffidavit[]
  courseResults         CourseResult[]
  examRegistrations     ExamRegistration[]
  fitnessRecords        FitnessRecord[]
  hallTickets           HallTicket[]
  hostelAccessLogs      HostelAccessLog[]
  jobOffers             JobOffer[]
  menteeAssignments     MenteeAssignment[]
  payments              Payment[]
  recordChangeRequests  RecordChangeRequest[]
  revaluationRequests   RevaluationRequest[]
  semesterResults       SemesterResult[]
  sportsAthletes        SportsAthlete[]
  transferRequests      TransferRequest[]
  verificationRequests  VerificationRequest[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt         DateTime?         
  deletedBy         String?
  assessmentCoMarks AssessmentCoMark[]

  @@unique([institutionId, rollNumber])
  @@index([institutionId])
  @@index([campusId])
  @@index([programmeId])
  @@index([batchId])
  @@index([sectionId])
}

// Profile for Faculty
model FacultyProfile {
  id     String @id @default(uuid()) @map("_id")
  userId String @unique

  /// TENANT KEY.
  /// Required since 0030. A NULLABLE tenant key is a hole in the filter: a
  /// NULL row matches no institution, so it becomes invisible and
  /// unrepairable rather than leaking.
  institutionId String
  campusId      String?

  /// Employee id — tenant-scoped, not globally unique.
  employeeId String

  /// Free-text qualification. RETAINED for display, but NOT aggregatable:
  /// "Ph.D", "PhD", "Ph.D." and "Doctorate" cannot be counted together.
  qualification String?

  /// STRUCTURED qualification — the NIRF "TLR" input.
  ///
  /// This field exists because the old code auto-created faculty with
  /// `qualification: 'Ph.D in CSE'` and `experience: 5` across 38 endpoints,
  /// fabricating doctorates that would have been reported to NIRF. Structured
  /// and nullable: unknown must read as unknown, never as a default doctorate.
  /// DOCTORATE | MPHIL | POSTGRADUATE | GRADUATE | OTHER
  qualificationLevel      String?
  /// Verification of the qualification claim — accreditation evidence.
  qualificationVerified   Boolean   @default(false)
  qualificationVerifiedAt DateTime?
  qualificationVerifiedBy String?

  specialization String?
  /// Years of experience. No default value is assumed.
  experience     Int     @default(0)

  /// Employment classification — NIRF and AISHE both require the split.
  /// permanent | contract | visiting | adjunct | emeritus
  employmentType String?
  dateOfJoining  DateTime?

  gender   String?
  category String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coursesTaught      Course[]
  classesAssigned    CourseClass[]
  attendanceSessions AttendanceSession[]
  publications       Publication[]
  researchProjects   ResearchProject[]
  patents            Patent[]
  leaveRequests      LeaveRequest[]
  promotionRequests  PromotionRequest[]  @relation("PromotionRequests")
  retirementRequests RetirementRequest[] @relation("RetirementRequests")

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Added in 0019 — the column existed with nothing enforcing the target.
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([institutionId, employeeId])
  @@index([institutionId])
  @@index([campusId])
  @@index([qualificationLevel])
}

// Academic Structure
model Department {
  id String @id @default(uuid()) @map("_id")

  /// TENANT KEY — nullable only during the backfill migration.
  /// Required since 0030. A NULLABLE tenant key is a hole in the filter: a
  /// NULL row matches no institution, so it becomes invisible and
  /// unrepairable rather than leaking.
  institutionId String
  campusId      String?
  schoolId      String?

  name String
  code String

  hodUserId String?
  isActive  Boolean @default(true)

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  campus      Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  school      School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  users       User[]               @relation("UserDepartment")
  courses     Course[]
  programmes  Programme[]
  budgets     DepartmentBudget[]
  recruitment FacultyRecruitment[]

  // ── Back-relations added in 0019 ──
  accreditationDatas  AccreditationData[]
  curriculumProposals CurriculumProposal[]
  disciplinaryCases   DisciplinaryCase[]
  labInventoryItems   LabInventoryItem[]
  purchaseRequests    PurchaseRequest[]
  timetableSlots      TimetableSlot[]

  /// Added in 0019 — the column existed with nothing enforcing the target.
  hodUser User? @relation(name: "DepartmentHod", fields: [hodUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  // Tenant-scoped uniqueness. These were GLOBALLY unique, which would have
  // prevented two universities from each having a "CSE" department — a
  // correctness bug the moment a second tenant exists.
  @@unique([institutionId, code])
  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([campusId])
  @@index([schoolId])
}

model Course {
  id String @id @default(uuid()) @map("_id")

  /// TENANT KEY — blueprint: "every course is linked to the campus/college
  /// that offers it".
  institutionId String

  /// Course code — tenant-scoped, not globally unique (see @@unique below).
  code         String
  name         String
  credits      Int
  semester     Int
  departmentId String
  facultyId    String?
  /// Lesson plan approval (LESSON_PLAN_APPROVAL: HOD → Dean).
  /// null = not submitted · submitted · approved · returned
  lessonPlanStatus String?
  lessonPlanNote   String?

  department Department      @relation(fields: [departmentId], references: [id])
  faculty    FacultyProfile? @relation(fields: [facultyId], references: [id])

  classes            CourseClass[]
  enrollments        Enrollment[]
  examinations       Examination[]
  schedules          CourseSchedule[]
  attendanceSessions AttendanceSession[]
  feedbacks          FeedbackForm[]
  lessonPlans        FacultyLessonPlan[]
  schemeCourses      SchemeCourse[]
  examSchedules      ExamSchedule[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  // ── Back-relations added in 0019 ──
  classMessages ClassMessage[]
  courseResults CourseResult[]

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
  @@index([facultyId])
}

