  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime?
  deletedBy String?
  /// Bumped by lockForUpdate() to claim the document inside a transaction —
  /// the MongoDB counterpart of SELECT … FOR UPDATE. Never read by business logic.
  lockVersion Int @default(0)


  @@index([institutionId])
  @@index([studentProfileId])
  @@index([status])
}

