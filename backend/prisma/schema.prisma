// Generic Approvals Workflow (used by HOD, Dean, VC)
model ApprovalItem {
  id          String   @id @default(uuid())
  type        String
  title       String
  details     String
  requestedBy String // reference to user ID 
  requestedAt DateTime @default(now()) @db.Timestamptz(3)
  amount      Float?
  priority    String
  /// pending | approved | rejected | forwarded | published
  /// `published` was added by migration 0023: dean.ts writes it on result
  /// publication. Migration 0022 constrained this column from the comment above,
  /// which was already incomplete, and broke that path. The CHECK constraint in
  /// the database is the authority; keep this list in step with it.
  status      String   @default("pending")

  /// TENANT KEY, added in 0022. Without it the approval queue was shared across
  /// every institution — one university's HOD could see and approve another's.
  institutionId String

  /// Who DECIDED, as opposed to who requested. An approval with no approver is
  /// not an approval; it is an assertion.
  decidedBy    String?
  decidedAt    DateTime? @db.Timestamptz(3)
  decisionNote String?

  /// Link to the workflow engine (Phase 2.4). Where this is set, the engine's
  /// transition log is the record of the decision and THIS ROW IS A PROJECTION
  /// of it, kept so existing queue screens keep working. Null on rows raised
  /// before the migration, and on the self-approving activity entries that were
  /// never routed to anyone.
  workflowInstanceId String?

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  workflow    WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([status])
  @@index([workflowInstanceId])
}

