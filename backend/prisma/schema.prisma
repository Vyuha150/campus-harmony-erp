// Finance & Infrastucture
model FeeRecord {
  id               String    @id @default(uuid()) @map("_id")
  /// Added in 0010. Fee records were previously UNSCOPED — a query without an
  /// explicit filter would return every institution's dues.
  institutionId    String
  studentProfileId String
  type             String
  description      String
  amount           Float
  /// Running total of allocations against this record. Partial payments are
  /// normal (an instalment plan), so `status` alone cannot express the state.
  paidAmount       Float     @default(0)
  dueDate          DateTime 
  paidDate         DateTime?
  /// pending | partial | paid | waived | overdue
  status           String
  transactionId    String?
  academicYear     String
  /// Set when a waiver is granted, with the reason — a fee written off with no
  /// recorded justification is an audit finding.
  waivedAmount     Float     @default(0)
  waiverReason     String?

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  /// Added in 0018 — the column existed with nothing enforcing that the
