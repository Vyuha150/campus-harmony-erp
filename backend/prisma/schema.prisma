  emergencyContact Json?
  status           String  @default("active")
}

// Sports — Teams (enhanced from existing Team model)
model SportsTeam {
  id               String  @id @default(uuid())
  sport            String
  category         String
  level            String  @default("university")
  coach            String
  captain          String?
  members          Json?
  practiceSchedule Json?
  upcomingMatches  Json?
  season           String
  status           String  @default("active")
}

// Sports — Facilities (enhanced from existing Facility model)
model SportsFacility {
  id                  String @id @default(uuid())
  name                String
  type                String
  sports              Json?
  capacity            Int
  amenities           Json?
  maintenanceSchedule Json?
  status              String @default("available")
}

// Sports — Inventory
model SportsInventoryItem {
  id                String    @id @default(uuid())
  itemName          String
  category          String
  sport             String
  brand             String?
  quantity          Int
  availableQuantity Int
  unitPrice         Float
  totalValue        Float
  condition         String    @default("good")
  purchaseDate      DateTime?
  lastMaintenance   DateTime?
  location          String
}

// Sports — Events
model SportsEvent {
  id           String   @id @default(uuid())
  name         String
  type         String
  sports       Json?
  startDate    DateTime
  endDate      DateTime
  venue        String
  organizer    String
  participants Json?
  results      Json?
  status       String   @default("planning")
}

// Sports — Fitness Records
model FitnessRecord {
  id              String    @id @default(uuid())
  studentId       String
  testDate        DateTime  @default(now())
  testType        String
  results         Json?
  overallGrade    String?
  recommendations String?
  restrictions    String?
  nextTestDate    DateTime?
  conductedBy     String

  @@index([studentId])
}

// Sports — Attendance
model SportsAttendance {
  id          String   @id @default(uuid())
  teamId      String
  date        DateTime @default(now())
  attendees   Json?
  notes       String?
  sessionType String   @default("training")

  @@index([teamId])
}

// Alumni — Events
model AlumniEvent {
