  status         String    @default("pending")
  feesPaid       Boolean   @default(false)
  documents      Json?
}

// Security — Vehicle Passes
model VehiclePass {
  id            String   @id @default(uuid())
  passNumber    String   @unique
  ownerName     String
  ownerType     String
  ownerIdNumber String
  vehicleType   String
  vehicleNumber String
  vehicleModel  String?
  validFrom     DateTime
  validUntil    DateTime
  parkingZone   String
  status        String   @default("active")
  feesPaid      Boolean  @default(false)
  documents     Json?
}

