// Phase 1 Additional Models //

// Library
/// One PHYSICAL COPY of a title.
///
/// `isbn` was previously `@unique` globally, which had two consequences: a
/// library could hold only one copy of any title, and once one institution
/// catalogued a book no other institution could. Copies are now identified by
/// `accessionNumber` — the number Indian libraries actually stamp inside the
/// cover — unique per institution.
model LibraryBook {
  id            String @id @default(uuid())
  /// Added in 0012. Library data was entirely unscoped before it.
  institutionId String

  /// Per-institution copy identifier. Two copies of the same title have the
  /// same ISBN and different accession numbers.
  accessionNumber String
  isbn            String
  title           String
  author          String
  category        String
  publisher       String?
  edition         String?

  /// available | issued | lost | damaged | withdrawn
  ///
  /// NOTE: `overdue` is deliberately NOT a stored status. Nothing ever set it,
  /// so the dashboard's overdue count was permanently zero. It is computed from
  /// the active loan's dueDate instead.
  status String @default("available")

  /// Denormalised pointer to the open loan, so "who has this copy" is one read.
  /// The authoritative record is LibraryLoan.
  currentLoanId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  loans LibraryLoan[]

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  /// Soft delete (0021). NULL means live. The Prisma extension injects
  /// `deletedAt: null` for this model, so filtering is structural rather
  /// than left to each call site.
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?

  @@unique([institutionId, accessionNumber])
  @@index([institutionId])
  @@index([isbn])
  @@index([status])
  @@index([title])
}

/// A circulation record — one per issue, retained after return.
///
/// Previously returning a book cleared `studentProfileId` on the book itself,
/// destroying any record of who had borrowed it. A fine was then left attached
/// to the copy with no link to the person who owed it.
model LibraryLoan {
  id            String @id @default(uuid())
  institutionId String

  bookId           String
  studentProfileId String

  issuedAt   DateTime  @default(now()) @db.Timestamptz(3)
  dueAt      DateTime  @db.Timestamptz(3)
  returnedAt DateTime? @db.Timestamptz(3)

  renewalCount Int @default(0)

  /// Computed on return from days overdue × the institution's rate — never
  /// accepted from the client, which is how the previous endpoint worked.
  fineAmount       Float   @default(0)
  finePaid         Boolean @default(false)
  /// Set when a fine is reduced or removed, with the reason.
  fineWaivedAmount Float   @default(0)
  fineWaiverReason String?

  /// active | returned | lost
  status String @default("active")

  issuedBy   String
  returnedTo String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  book    LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([bookId])
  @@index([studentProfileId])
  @@index([status])
  @@index([dueAt])
}

/// Per-institution circulation rules.
///
/// The previous code hardcoded a 14-day loan and a client-supplied fine. Loan
/// periods and fine rates differ by institution and by borrower category, and
/// are usually fixed by the library committee — they are configuration, not
/// constants in a route handler.
model LibraryPolicy {
  id            String @id @default(uuid())
  institutionId String @unique

  loanPeriodDays      Int   @default(14)
  maxRenewals         Int   @default(2)
  renewalDays         Int   @default(14)
  /// Rupees per day past the due date.
  finePerDay          Float @default(1)
  /// Days after the due date before a fine starts accruing.
  graceDays           Int   @default(0)
  /// Ceiling, so an unreturned book does not accrue an unbounded fine.
  maxFine             Float @default(500)
  /// Copies one borrower may hold at once.
  maxBooksPerStudent  Int   @default(3)
  /// Block further issues while the borrower owes more than this.
  blockIssueAboveFine Float @default(100)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Added in 0018 — the column existed with nothing enforcing that the
  /// referenced institution exists.
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
}

