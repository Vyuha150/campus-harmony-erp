// Registrar — Exam Progress
model ExamProgress {
  id String @id @default(uuid()) @map("_id")

  /// TENANT KEY, added in 0027. Without it the examination schedule was shared
  /// across every institution, and two handlers wrote it with
  /// `update({ where: { id }, data: req.body })` — a unique-key update the
  /// tenant extension cannot constrain, carrying an unfiltered request body.
  institutionId    String
  examName         String
  semester         String
  program          String
  /// Stored figures. These are a FALLBACK. When `examSessionId` is set, the
  /// read path derives `totalStudents`, `marksEntered` and `resultsPublished`
  /// from the examination engine instead, because these columns cannot track
  /// anything on their own: `marksEntered` is written as 0 on create and no
  /// code anywhere ever updated it.
  totalStudents    Int
  marksEntered     Int      @default(0)
  resultsPublished Boolean  @default(false)

  /// The examination session this row reports on, once the institution runs
  /// one. Nullable because an institution can track an examination here
  /// before adopting the session workflow — which is the state every
  /// institution starts in, and the reason this table still exists.
  examSessionId String?

  status           String   @default("scheduling")
  startDate        DateTime
  endDate          DateTime
  coordinator      String

  institution Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  /// SetNull, not Cascade: deleting a session must not silently delete the
  /// oversight record of the examination it reported on.
  examSession ExamSession? @relation(fields: [examSessionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
}

