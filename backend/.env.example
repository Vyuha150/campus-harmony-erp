# ─────────────────────────────────────────────────────────────────────────────
# Campus Harmony ERP — Backend Environment
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# The server VALIDATES every variable at boot and REFUSES TO START if a
# required one is missing or unsafe. This is deliberate — see src/config/env.ts.
#
# NEVER commit a real `.env`. NEVER reuse these placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campus_harmony?schema=public"

# Connection pool. Raise poolMax only alongside PostgreSQL's own max_connections.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# TLS certificate verification for the DB connection.
# Leave `true` in any shared environment. Setting `false` permits a
# man-in-the-middle on the database connection; it is ignored in production.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ── Authentication (REQUIRED) ────────────────────────────────────────────────
# JWT signing secret. NO DEFAULT EXISTS — the server will not start without it.
# Minimum 32 characters. Generate a strong one with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The legacy hardcoded value "supersecretkey123" is explicitly REJECTED: it is
# published in this repository's git history and would allow anyone to forge a
# super_admin token.
JWT_SECRET="CHANGE_ME_generate_with_the_command_above_min_32_chars"

JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=12

# ── Rate limiting ────────────────────────────────────────────────────────────
# Login throttling — protects against credential stuffing.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# General API throttling.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is rejected (credentialed requests need
# explicit origins). Production requires https://.
CORS_ORIGINS=http://localhost:8080

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_DIR=uploads

# ── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=debug

# ── Seeding (development only) ───────────────────────────────────────────────
# The seed script REFUSES to run unless NODE_ENV=development, to prevent
# creating 17 privileged accounts with a shared password in a live environment.
# To override deliberately (e.g. a disposable CI database), set:
#   ALLOW_SEED=yes
SEED_DEFAULT_PASSWORD="ChangeMe@Dev123456"
