# Production backend settings. On the VPS copy to /var/www/campus-harmony-erp/backend/.env
# and fill in the values marked CHANGE. Never commit the filled-in file.

NODE_ENV=production
PORT=8726

# CHANGE: the company Atlas cluster, with the database name in the path.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.h8l9lc6.mongodb.net/campus_harmony?retryWrites=true&w=majority&appName=campus-harmony"
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# CHANGE: a fresh secret for production (not the development one):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# CHANGE: the public address the ERP is served from (https only in production).
CORS_ORIGINS=https://campus-erp.ivyuha.in

UPLOAD_MAX_FILE_SIZE_BYTES=26214400
UPLOAD_DIR=uploads

# In-app notifications only until SMTP / SMS accounts are provided.
NOTIFICATION_DRIVER=log
LOG_LEVEL=info
